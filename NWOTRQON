<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AgriGuide</title>

    <link rel="stylesheet" href="style.css" />
  </head>

  <body>
    <div class="tech-lines"></div>
    <!-- LOGIN PAGE -->
    <div class="container" id="loginPage">
      <h1>🌾 AgriGuide</h1>
      <p>Smart guidance for modern farming</p>

      <div class="buttons">
        <button onclick="showDashboard()">Login</button>
        <button>Sign Up</button>
      </div>
    </div>

    <!-- DASHBOARD -->
    <button onclick="toggleTheme()" id="themeBtn">🌙 Tech Mode</button>
    <div class="dashboard" id="dashboardPage" style="display: none">
      <h2>Welcome to AgriGuide 🌿</h2>
      <select id="languageSelect" onchange="changeLanguage()">
        <option value="en">English</option>

        <option value="hi">हिंदी</option>

        <option value="mr">मराठी</option>

        <option value="gu">ગુજરાતી</option>

        <option value="pa">ਪੰਜਾਬੀ</option>

        <option value="ta">தமிழ்</option>

        <option value="te">తెలుగు</option>

        <option value="kn">ಕನ್ನಡ</option>

        <option value="bn">বাংলা</option>

        <option value="rj">मारवाड़ी</option>
      </select>

      <br /><br />

      <div class="cards">
        <div class="card" onclick="openScanPage()">
          <h3>📸 Scan Crop</h3>
          <p>Analyze crop requirements</p>
        </div>

        <div class="card" onclick="openMyCrops()">
          <h3>🌾 My Crops</h3>
          <p>Add your crops</p>
        </div>

        <div class="card" onclick="openMarket()">
          <h3>📊 Market</h3>
          <p>View all crop prices</p>
        </div>
        <div class="card" onclick="openWeather()">
          <h3>🌦 Weather</h3>

          <p>Check farming weather updates</p>
        </div>
      </div>
    </div>

    <!-- SCAN PAGE -->
    <div class="page" id="scanPage" style="display: none">
      <h2>📸 Scan Your Crop</h2>

      <input type="file" id="scanImage" />

      <br /><br />

      <div class="button-group">
        <button onclick="scanCrop()">Analyze Crop</button>

        <button onclick="goDashboard()">⬅ Back</button>
      </div>
    </div>

    <!-- RESULT PAGE -->
    <div class="page" id="resultPage" style="display: none">
      <h2>🌱 Crop Analysis</h2>

      <div id="scanResult"></div>

      <br />

      <button onclick="goDashboard()">🏠 Dashboard</button>
    </div>

    <!-- MY CROPS -->
    <div class="page" id="myCropsPage" style="display: none">
      <h2>🌾 My Crops</h2>

      <input type="file" id="cropImage" />
      <br /><br />

      <input type="text" id="cropName" placeholder="Enter crop name" />
      <br /><br />

      <input type="number" id="cropPrice" placeholder="Enter crop price" />
      <br /><br />

      <div class="button-group">
        <button onclick="addCrop()">Add Crop</button>

        <button onclick="goDashboard()">⬅ Back</button>
      </div>
    </div>

    <!-- MARKET -->
    <div class="page" id="marketPage" style="display: none">
      <h1>📊 Crop Market</h1>
      <button onclick="startVoice()" class="voiceBtn">
        🎤 Speak Crop Name
      </button>

      <br /><br />

      <div id="marketList"></div>

      <br />

      <button onclick="goDashboard()">⬅ Back</button>
    </div>
    <!-- WEATHER PAGE -->
    <div class="page" id="weatherPage" style="display: none">
      <h1>🌦 Weather Prediction</h1>

      <input type="text" id="cityInput" placeholder="Enter City Name" />

      <br /><br />

      <button onclick="showWeather()">Check Weather</button>

      <br /><br />

      <div id="weatherResult"></div>

      <br />

      <button onclick="goDashboard()">⬅ Back</button>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="script.js"></script>
  </body>
</html>
